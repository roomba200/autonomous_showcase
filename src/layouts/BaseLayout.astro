---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "The Autonomous Collection" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <ClientRouter />

    <link rel="icon" href="/favicon.png" sizes="any" />
  </head>
  <body
    class="bg-white text-gray-900 transition-colors dark:bg-gray-950 dark:text-gray-100 max-w-6xl mx-auto px-8 lg:px-12 flex flex-col"
  >
    <main class="grow"><slot /></main>
  </body>
</html>
