---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  robots: CollectionEntry<"robots">[];
}

const { robots }: Props = Astro.props;
---

<section id="products">
  <div class="py-12 md:py-20">
    <header class="mb-12 max-w-2xl md:mb-16">
      <p
        class="mb-4 text-sm font-medium uppercase tracking-wide text-orange-600"
      >
        The Autonomous Collection
      </p>
      <h1
        class="text-4xl font-semibold tracking-tight text-gray-900 dark:text-gray-100 md:text-6xl"
      >
        Intelligent units for modern environments.
      </h1>
      <p
        class="mt-5 max-w-xl text-base leading-7 text-gray-600 dark:text-gray-400"
      >
        A curated series of versatile, purpose-built robots designed to
        streamline work, security, and everyday life.
      </p>
    </header>

    <div
      class="grid grid-cols-1 gap-x-6 gap-y-12 md:grid-cols-2 lg:grid-cols-3 lg:gap-y-20"
    >
      {
        robots.map((product) => (
          <figure class="group relative">
            <a href={`/robot/${product.id}`} class="block">
              <Image
                width="800"
                height="800"
                alt={product.data.title}
                src={product.data.image}
                transition:name={`product-image-${product.id}`}
                class="aspect-12/9 w-full rounded-3xl object-cover object-center shadow transition duration-300 group-hover:shadow-lg group-hover:brightness-95"
              />
            </a>
            <div class="mt-4 flex items-start justify-between gap-4">
              <div>
                <h2 class="text-base font-medium text-gray-900 dark:text-gray-100">
                  {product.data.title}
                </h2>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                  {product.data.subtitle}
                </p>
              </div>
              <p class="shrink-0 text-base font-medium text-orange-600">
                {product.data.price}
              </p>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>
