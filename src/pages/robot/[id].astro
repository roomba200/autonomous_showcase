---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const robots = await getCollection('robots', ({ data }) => !data.draft);
	return robots.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.title} | The Autonomous Collection`}>
	<section class="px-6 py-10 md:py-16">
		<div class="mx-auto max-w-6xl">
			<button onclick="history.back()" class="mb-10 block text-sm text-inherit no-underline bg-none border-none cursor-pointer p-0">← Back to Products</button>

			<div class="grid items-start gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)] md:gap-16">
				<div>
				<Image
					width="800"
					height="800"
					alt={entry.data.title}
					src={entry.data.image}
					transition:name={`product-image-${entry.id}`}
					class="aspect-square w-full rounded-3xl object-cover object-center shadow-lg"
				/>
				</div>

				<div class="pt-2 md:pt-8">
					<p class="mb-3 text-sm font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">{entry.data.subtitle}</p>
					<h1 class="mb-5 text-4xl font-semibold tracking-tight md:text-5xl">{entry.data.title}</h1>
					<p class="text-3xl font-semibold text-orange-600">{entry.data.price}</p>
					<div class="mt-8 border-t border-gray-200 pt-8 dark:border-gray-800">
						<div class="prose prose-sm max-w-none dark:prose-invert">
							<Content />
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>